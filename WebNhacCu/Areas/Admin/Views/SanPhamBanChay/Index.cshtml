@using System.Linq
@model CoreDatabase.ViewModels.SanPhamBanChayViewModel
@{
    ViewData["Title"] = "Sản Phẩm Bán Chạy";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml"; // ⚠️ Kiểm tra lại đúng file Layout Admin
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container-fluid p-4 bg-light" style="min-height: 100vh;">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-primary m-0"><i class="fa-solid fa-fire text-danger me-2"></i>SẢN PHẨM BÁN CHẠY</h4>
        <span class="text-muted"><i class="fa-solid fa-house"></i> Thống kê > <strong>Sản phẩm bán chạy</strong></span>
    </div>

    <!-- BỘ LỌC THỜI GIAN & TOP -->
    <div class="card border-0 shadow-sm p-3 mb-4">
        <form method="get" action="/Admin/SanPhamBanChay" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-bold">Từ ngày:</label>
                <input type="date" name="tuNgay" value="@Model.TuNgay.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Đến ngày:</label>
                <input type="date" name="denNgay" value="@Model.DenNgay.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Top:</label>
                <select name="top" class="form-select">
                    <option value="5" selected="@(Model.Top == 5)">5</option>
                    <option value="10" selected="@(Model.Top == 10)">10</option>
                    <option value="20" selected="@(Model.Top == 20)">20</option>
                    <option value="50" selected="@(Model.Top == 50)">50</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Nhóm theo:</label>
                <select name="nhomTheo" class="form-select">
                    <option value="SoLuong" selected="@(Model.NhomTheo == "SoLuong")">Số lượng bán</option>
                    <option value="DoanhThu" selected="@(Model.NhomTheo == "DoanhThu")">Doanh thu</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary fw-semibold px-3"><i class="fa-solid fa-filter me-1"></i> Xem báo cáo</button>
                <button type="button" class="btn btn-outline-success btn-sm fw-semibold"><i class="fa-solid fa-file-excel me-1"></i> Xuất Excel</button>
                <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> In báo cáo</button>
            </div>
        </form>
    </div>

    <!-- BẢNG DỮ LIỆU SẢN PHẨM BÁN CHẠY -->
    <div class="card border-0 shadow-sm p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle border">
                <thead class="table-light">
                    <tr class="text-secondary fw-bold">
                        <th class="text-center" style="width: 60px;">STT</th>
                        <th>Mã sản phẩm</th>
                        <th>Tên sản phẩm</th>
                        <th>Loại sản phẩm</th>
                        <th>Thương hiệu</th>
                        <th class="text-center">Số lượng bán</th>
                        <th class="text-end">Doanh thu</th>
                        <th class="text-end">Giá bán TB</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.DanhSachSanPham != null && Model.DanhSachSanPham.Count > 0)
                    {
                        foreach (var item in Model.DanhSachSanPham)
                        {
                            <tr>
                                <td class="text-center fw-bold text-muted">@item.STT</td>
                                <td class="fw-bold text-primary">@item.MaSP</td>
                                <td class="fw-semibold text-dark">@item.TenSP</td>
                                <td><span class="badge bg-light text-dark border">@item.LoaiSP</span></td>
                                <td>@item.ThuongHieu</td>
                                <td class="text-center fw-bold">@item.SoLuongBan</td>
                                <td class="text-end fw-bold text-primary">@item.DoanhThu.ToString("N0") đ</td>
                                <td class="text-end text-secondary">@item.GiaBanTB.ToString("N0") đ</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Không tìm thấy dữ liệu bán hàng trong khoảng thời gian này.</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr class="fs-6">
                        <td colspan="5" class="text-uppercase text-dark">TỔNG CỘNG</td>
                        <td class="text-center text-success fs-5">@Model.TongSoLuongBan.ToString("N0")</td>
                        <td class="text-end text-primary fs-5">@Model.TongDoanhThu.ToString("N0") đ</td>
                        <td class="text-end text-muted">-</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>