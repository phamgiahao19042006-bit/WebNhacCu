@model IEnumerable<CoreDatabase.Models.LoaiSP>
@{
    ViewData["Title"] = "Quản lý Loại Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml";
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h3 class="fw-bold" style="color: #2c1d11;">Danh Sách Loại Sản Phẩm</h3>
        <a asp-area="Admin" asp-controller="LoaiSanPham" asp-action="Create" class="btn text-white fw-bold px-3 py-2" style="background-color: #c5a059;">
            <i class="fa-solid fa-plus me-1"></i> Thêm Loại Mới
        </a>
    </div>

    <!-- Thông báo thành công -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Khung Tìm kiếm & Lọc -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form asp-area="Admin" asp-controller="LoaiSanPham" asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm theo Mã loại hoặc Tên loại..." />
                    </div>
                </div>

                <div class="col-md-4">
                    <select name="statusFilter" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="true" selected="@(ViewBag.StatusFilter == "true")">Đang kinh doanh</option>
                        <option value="false" selected="@(ViewBag.StatusFilter == "false")">Dừng kinh doanh</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn fw-bold text-white flex-grow-1" style="background-color: #2c1d11;">
                        <i class="fa-solid fa-filter me-1"></i> Lọc
                    </button>
                    <a asp-area="Admin" asp-controller="LoaiSanPham" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-rotate-right"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng Dữ Liệu -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 120px;">Mã loại</th>
                            <th style="width: 250px;">Tên loại</th>
                            <th>Mô tả</th>
                            <th style="width: 160px;">Trạng thái</th>
                            <th class="text-end pe-3" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">@item.MaLoai</td>
                                    <td class="fw-bold" style="color: #2c1d11;">@item.TenLoai</td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(item.MoTa) ? "Chưa có mô tả" : item.MoTa)</td>
                                    <td>
                                        @if (item.TT)
                                        {
                                            <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Đang kinh doanh</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="fa-solid fa-ban me-1"></i>Dừng kinh doanh</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-area="Admin" asp-controller="LoaiSanPham" asp-action="Edit" asp-route-id="@item.MaLoai" class="btn btn-sm btn-outline-warning text-dark me-1" title="Sửa">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>

                                        @if (item.TT)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Dừng kinh doanh"
                                                    onclick="confirmDelete('@item.MaLoai', '@item.TenLoai')">
                                                <i class="fa-solid fa-power-off"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-folder-open fs-2 mb-2 d-block"></i>
                                    Không tìm thấy loại sản phẩm nào!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Form Xóa mềm -->
<form id="deleteForm" asp-area="Admin" asp-controller="LoaiSanPham" asp-action="DeleteSoft" method="post">
    <input type="hidden" id="deleteId" name="id" />
</form>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            if (confirm("Bạn có chắc muốn dừng kinh doanh loại sản phẩm " + name + " không?")) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}