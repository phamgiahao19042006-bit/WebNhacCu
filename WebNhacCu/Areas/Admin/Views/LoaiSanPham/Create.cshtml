@model CoreDatabase.Models.LoaiSP
@{
    ViewData["Title"] = "Thêm Loại Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml";
}

<div class="container-fluid p-0">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3" style="border-bottom: 2px solid #c5a059;">
                    <h5 class="m-0 fw-bold" style="color: #2c1d11;"><i class="fa-solid fa-plus me-2"></i>Thêm Loại Sản Phẩm Mới</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-area="Admin" asp-controller="LoaiSanPham" asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Tên loại -->
                        <div class="mb-3">
                            <label asp-for="TenLoai" class="form-label fw-bold">Tên loại sản phẩm <span class="text-danger">*</span></label>
                            <input asp-for="TenLoai" class="form-control" placeholder="Nhập tên loại (VD: Đàn Guitar, Piano...)" required />
                            <span asp-validation-for="TenLoai" class="text-danger fs-7"></span>
                        </div>

                        <!-- Mô tả -->
                        <div class="mb-4">
                            <label asp-for="MoTa" class="form-label fw-bold">Mô tả</label>
                            <textarea asp-for="MoTa" class="form-control" rows="4" placeholder="Nhập mô tả chi tiết..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger fs-7"></span>
                        </div>

                        <!-- Nút thao tác -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-area="Admin" asp-controller="LoaiSanPham" asp-action="Index" class="btn btn-secondary px-4 fw-bold">
                                <i class="fa-solid fa-xmark me-1"></i> Hủy
                            </a>
                            <button type="submit" class="btn text-white px-4 fw-bold" style="background-color: #c5a059;">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Lưu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>