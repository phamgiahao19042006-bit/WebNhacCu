@model WebNhacCu.Models.LoaiSP
@{
    ViewData["Title"] = "Cập Nhật Loại Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml";
}

<div class="container-fluid p-0">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3" style="border-bottom: 2px solid #c5a059;">
                    <h5 class="m-0 fw-bold" style="color: #2c1d11;"><i class="fa-solid fa-pen-to-square me-2"></i>Cập Nhật Loại Sản Phẩm</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-area="Admin" asp-controller="LoaiSanPham" asp-action="Edit" method="post">
                        <input type="hidden" asp-for="MaLoai" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Mã loại (Readonly) -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Mã loại sản phẩm</label>
                            <input value="@Model.MaLoai" class="form-control bg-light" readonly />
                        </div>

                        <!-- Tên loại -->
                        <div class="mb-3">
                            <label asp-for="TenLoai" class="form-label fw-bold">Tên loại sản phẩm <span class="text-danger">*</span></label>
                            <input asp-for="TenLoai" class="form-control" required />
                            <span asp-validation-for="TenLoai" class="text-danger fs-7"></span>
                        </div>

                        <!-- Mô tả -->
                        <div class="mb-3">
                            <label asp-for="MoTa" class="form-label fw-bold">Mô tả</label>
                            <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="MoTa" class="text-danger fs-7"></span>
                        </div>

                        <!-- Trạng thái -->
                        <div class="mb-4">
                            <label asp-for="TT" class="form-label fw-bold">Trạng thái kinh doanh</label>
                            <select asp-for="TT" class="form-select">
                                <option value="true">Đang kinh doanh</option>
                                <option value="false">Dừng kinh doanh</option>
                            </select>
                        </div>

                        <!-- Nút thao tác -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-area="Admin" asp-controller="LoaiSanPham" asp-action="Index" class="btn btn-secondary px-4 fw-bold">
                                <i class="fa-solid fa-xmark me-1"></i> Hủy
                            </a>
                            <button type="submit" class="btn text-white px-4 fw-bold" style="background-color: #c5a059;">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Lưu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>