@model IEnumerable<CoreDatabase.Models.HoaDon>

@{
    ViewData["Title"] = "Hóa Đơn";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml";
}

<!-- FontAwesome & SweetAlert2 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid p-4 bg-light" style="min-height: 100vh;">

    <!-- 1. HEADER -->
    <div class="d-flex align-items-center gap-2 mb-3">
        <i class="fa-solid fa-file-invoice fs-3 text-primary"></i>
        <h3 class="fw-bold m-0 text-primary text-uppercase" style="letter-spacing: 0.5px;">HÓA ĐƠN</h3>
    </div>

    <!-- 2. NÚT THAO TÁC TRÊN -->
    <div class="d-flex gap-2 mb-3">
        <a href="/Admin/HoaDon/LapHoaDon" class="btn btn-primary fw-semibold px-3 py-2 shadow-sm d-flex align-items-center gap-2">
            <i class="fa-solid fa-plus"></i> Thêm hóa đơn
        </a>
    </div>

    <!-- 3. BỘ LỌC TÌM KIẾM -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 8px;">
        <div class="card-body p-3">
            <form method="get" action="/Admin/HoaDon/Index" class="row g-2 align-items-center">
                <div class="col-lg-3 col-md-6">
                    <div class="input-group">
                        <input type="text" name="keyword" class="form-control bg-light border-end-0" placeholder="Tìm kiếm: Nhập mã HĐ, tên KH, SĐT..." style="font-size: 14px;" />
                        <span class="input-group-text bg-light border-start-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 d-flex align-items-center gap-1">
                    <label class="form-label mb-0 text-nowrap text-secondary" style="font-size: 13px;">Từ ngày:</label>
                    <input type="date" name="fromDate" value="2025-06-01" class="form-control bg-light" style="font-size: 14px;" />
                </div>

                <div class="col-lg-2 col-md-3 d-flex align-items-center gap-1">
                    <label class="form-label mb-0 text-nowrap text-secondary" style="font-size: 13px;">Đến ngày:</label>
                    <input type="date" name="toDate" value="2026-06-08" class="form-control bg-light" style="font-size: 14px;" />
                </div>

                <div class="col-lg-2 col-md-4 d-flex align-items-center gap-1">
                    <label class="form-label mb-0 text-nowrap text-secondary" style="font-size: 13px;">Khách hàng:</label>
                    <select name="maKH" class="form-select bg-light" style="font-size: 14px;">
                        <option value="">Tất cả</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-4 d-flex align-items-center gap-1">
                    <label class="form-label mb-0 text-nowrap text-secondary" style="font-size: 13px;">Trạng thái:</label>
                    <select name="status" class="form-select bg-light" style="font-size: 14px;">
                        <option value="">Tất cả</option>
                        <option value="true">Hoàn thành</option>
                        <option value="false">Đã hủy</option>
                    </select>
                </div>

                <div class="col-lg-1 col-md-4 text-end">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold d-flex align-items-center justify-content-center gap-1" style="font-size: 14px;">
                        <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 4. BẢNG DỮ LIỆU HÓA ĐƠN -->
    <div class="card border-0 shadow-sm" style="border-radius: 8px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center" style="font-size: 14px;">
                <thead class="bg-light border-bottom">
                    <tr class="text-secondary fw-bold">
                        <th class="py-3">Mã HĐ</th>
                        <th class="py-3">Ngày lập</th>
                        <th class="py-3 text-start">Khách hàng</th>
                        <th class="py-3">Nhân viên</th>
                        <th class="py-3 text-end">Tổng tiền</th>
                        <th class="py-3 text-end">Giảm giá</th>
                        <th class="py-3 text-end">Thành tiền</th>
                        <th class="py-3">Phương thức TT</th>
                        <th class="py-3">Trạng thái</th>
                        <th class="py-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="fw-bold text-dark">@item.MaHD</td>
                                <td class="text-secondary">@item.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-start fw-semibold text-dark">@item.MaKH</td>
                                <td class="text-secondary">@item.MaNV</td>
                                <td class="text-end fw-semibold text-dark">@string.Format("{0:N0}", item.TongTien)</td>
                                <td class="text-end text-secondary">@string.Format("{0:N0}", item.GiamGia)</td>
                                <td class="text-end fw-bold text-primary">@string.Format("{0:N0}", item.ThanhTien)</td>
                                <td class="text-secondary">@(item.PhuongThucTT ?? "Tiền mặt")</td>
                                <td>
                                    @if (item.TT == true)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-medium">Hoàn thành</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill fw-medium">Đã hủy</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                       <div class="d-flex justify-content-center gap-1">
                                            <!-- Nút xem Chi tiết hóa đơn -->
                                            <a href="/Admin/CTHoaDon/Index?maHD=@item.MaHD" class="btn btn-sm btn-light text-info border rounded-3 px-2 py-1" title="Chi tiết">
                                                <i class="fa-regular fa-eye"></i>
                                            </a>
        <!-- Nút SỬA: Chuyển trực tiếp sang trang Edit -->
        <a href="/Admin/HoaDon/Edit/@item.MaHD" class="btn btn-sm btn-light text-warning border rounded-3 px-2 py-1" title="Chỉnh sửa">
            <i class="fa-regular fa-pen-to-square"></i>
        </a>
                                        <!-- Nút XÓA -->
                                        <button type="button" class="btn btn-sm btn-light text-danger border rounded-3 px-2 py-1" 
                                                onclick="confirmDelete('@item.MaHD')" title="Xóa">
                                            <i class="fa-regular fa-trash-can"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">Không có hóa đơn nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 5. PHÂN TRANG -->
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="text-secondary" style="font-size: 14px;">Hiển thị 1 - 5 / 25 hóa đơn</span>
            <ul class="pagination pagination-sm m-0">
                <li class="page-item disabled"><a class="page-link text-secondary" href="#">«</a></li>
                <li class="page-item active"><a class="page-link bg-primary border-primary" href="#">1</a></li>
                <li class="page-item"><a class="page-link text-secondary" href="#">2</a></li>
                <li class="page-item"><a class="page-link text-secondary" href="#">3</a></li>
                <li class="page-item disabled"><a class="page-link text-secondary" href="#">...</a></li>
                <li class="page-item"><a class="page-link text-secondary" href="#">5</a></li>
                <li class="page-item"><a class="page-link text-secondary" href="#">»</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- ================= MODAL CHỈNH SỬA HÓA ĐƠN ================= -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="/Admin/HoaDon/Edit" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-primary" id="editModalLabel">SỬA HÓA ĐƠN</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Mã Hóa Đơn</label>
                        <input type="text" id="editMaHD" name="MaHD" class="form-control bg-light" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Khách Hàng</label>
                        <input type="text" id="editMaKH" name="MaKH" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nhân Viên</label>
                        <input type="text" id="editMaNV" name="MaNV" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Phương Thức TT</label>
                        <select id="editPTTT" name="PhuongThucTT" class="form-select">
                            <option value="Tiền mặt">Tiền mặt</option>
                            <option value="Chuyển khoản">Chuyển khoản</option>
                            <option value="Thẻ ngân hàng">Thẻ ngân hàng</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Tổng Tiền</label>
                        <input type="number" id="editTongTien" name="TongTien" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Giảm Giá</label>
                        <input type="number" id="editGiamGia" name="GiamGia" class="form-control" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Trạng Thái</label>
                        <select id="editTT" name="TT" class="form-select">
                            <option value="true">Hoàn thành</option>
                            <option value="false">Đã hủy</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-semibold">Cập nhật hóa đơn</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SCRIPT XỬ LÝ SỬA & XÓA -->
<script>
    // Hàm mở Modal và nạp dữ liệu cũ vào form
    function openEditModal(maHD, maKH, maNV, tongTien, giamGia, pttt, status) {
        document.getElementById('editMaHD').value = maHD;
        document.getElementById('editMaKH').value = maKH;
        document.getElementById('editMaNV').value = maNV;
        document.getElementById('editTongTien').value = tongTien;
        document.getElementById('editGiamGia').value = giamGia;
        document.getElementById('editPTTT').value = pttt || 'Tiền mặt';
        document.getElementById('editTT').value = (status === 'True' || status === 'true') ? 'true' : 'false';

        var myModal = new bootstrap.Modal(document.getElementById('editModal'));
        myModal.show();
    }

    // Hàm Xóa bằng SweetAlert2
    function confirmDelete(maHD) {
        Swal.fire({
            title: 'Xác nhận xóa?',
            text: "Bạn có chắc chắn muốn xóa hóa đơn " + maHD + " không?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Xóa ngay',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/Admin/HoaDon/Delete/' + maHD;
            }
        });
    }
</script>

<!-- Hiện Popup Thành Công sau khi bấm Sửa hoặc Xóa -->
@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            title: 'Thành công!',
            text: '@TempData["SuccessMessage"]',
            icon: 'success',
            confirmButtonText: 'OK',
            confirmButtonColor: '#3085d6'
        });
    </script>
}