@model CoreDatabase.Models.ThuongHieu

@{
    ViewData["Title"] = "Sửa Thương Hiệu";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase m-0">[SỬA THƯƠNG HIỆU: @Model.MaTH]</h2>
        <a href="/Admin/ThuongHieu" class="btn btn-outline-secondary px-4">Quay lại</a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4" style="border-radius: 8px;">
                <form action="/Admin/ThuongHieu/Edit" method="post">
                    @Html.AntiForgeryToken()
                    
                    <!-- Khóa chính ẩn để binding vào model -->
                    <input type="hidden" name="MaTH" value="@Model?.MaTH" />

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Mã thương hiệu</label>
                        <input class="form-control bg-light" value="@Model?.MaTH" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Tên thương hiệu</label>
                        <input name="TenTH" class="form-control" value="@Model?.TenTH" required />
                    </div>

                    <!-- 💥 THÊM Ô NHẬP QUỐC GIA VÀO ĐÂY -->
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Quốc gia</label>
                        <input name="QuocGia" class="form-control" value="@Model?.QuocGia" placeholder="Ví dụ: Nhật Bản, Mỹ, Đức..." />
                    </div>

                    <!-- Nút Lưu & Hủy -->
                    <div class="mt-4">
                        <button type="submit" class="btn btn-success">Lưu Thay Đổi</button>
                        <a href="/Admin/ThuongHieu/Index" class="btn btn-secondary ms-2">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>