@model IEnumerable<CoreDatabase.Models.ThuongHieu>

@{
    ViewData["Title"] = "Quản lý Thương Hiệu";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml";
}

<!-- Thư viện SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-uppercase">DANH SÁCH THƯƠNG HIỆU</h3>
        <a href="/Admin/ThuongHieu/Create" class="btn btn-primary fw-bold">+ Thêm thương hiệu</a>
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 20%;">Mã TH</th>
                <th style="width: 35%;">Tên Thương Hiệu</th>
                <th style="width: 25%;">Quốc Gia</th>
                <th style="width: 20%;" class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">#@item.MaTH</td>
                        <td class="text-primary fw-bold">@item.TenTH</td>
                        <td>@(string.IsNullOrEmpty(item.QuocGia) ? "-" : item.QuocGia)</td>
                        <td class="text-center">
                            <!-- Nút Sửa -->
                            <a href="/Admin/ThuongHieu/Edit/@item.MaTH" class="btn btn-sm btn-outline-warning me-1" title="Sửa">
                                ✏️
                            </a>

                            <!-- Nút Xóa (Bật Popup SweetAlert2) -->
                            <button type="button" 
                                    class="btn btn-sm btn-outline-danger" 
                                    title="Xóa"
                                    onclick="confirmDelete('@item.MaTH', '@item.TenTH')">
                                🗑️
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
    // 1. Thông báo cập nhật / xóa thành công
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
        Swal.fire({
            title: 'Thành công!',
            text: '@TempData["SuccessMessage"]',
            icon: 'success',
            confirmButtonText: 'OK',
            confirmButtonColor: '#198754'
        });
        </text>
    }

    // 2. Hỏi trước khi xóa
    function confirmDelete(id, name) {
        Swal.fire({
            title: 'Xác nhận xóa?',
            text: "Bạn có chắc chắn muốn xóa thương hiệu [" + name + "] không?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Đồng ý xóa',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/Admin/ThuongHieu/Delete/' + id;
            }
        });
    }
</script>