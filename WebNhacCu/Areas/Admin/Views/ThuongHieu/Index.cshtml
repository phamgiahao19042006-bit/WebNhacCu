@model IEnumerable<CoreDatabase.Models.ThuongHieu>

@{
    ViewData["Title"] = "Quản lý Thương Hiệu";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-uppercase m-0">Danh Sách Thương Hiệu</h4>
        <a href="/Admin/ThuongHieu/Create" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Thêm thương hiệu
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3" style="width: 120px;">Mã TH</th>
                        <th>Tên Thương Hiệu</th>
                        <th>Mô tả</th>
                        <th>Ngày tạo</th>
                        <th class="text-end pe-3" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">#@item.MaTH</td>
                                <td class="fw-semibold text-primary">@item.TenTH</td>
                                <td>@(string.IsNullOrEmpty(item.QuocGia) ? "-" : item.QuocGia)</td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-3">
                                    <a href="/Admin/ThuongHieu/Edit/@item.MaTH" class="btn btn-sm btn-outline-warning me-1" title="Sửa">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteThuongHieu('@item.MaTH')" title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Chưa có thương hiệu nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function deleteThuongHieu(id) {
        Swal.fire({
            title: 'Xác nhận xóa?',
            text: "Hào có chắc chắn muốn xóa thương hiệu " + id + " không?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Xóa ngay',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                // Gửi request POST chuẩn kèm tham số ID
                let formData = new FormData();
                formData.append("id", id);

                fetch('/Admin/ThuongHieu/Delete/' + id, {
                    method: 'POST',
                    body: formData
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                title: 'Đã xóa!',
                                text: data.message,
                                icon: 'success',
                                confirmButtonColor: '#198754'
                            }).then(() => location.reload());
                        } else {
                            Swal.fire('Lỗi!', data.message, 'error');
                        }
                    })
                    .catch(err => {
                        Swal.fire('Lỗi!', 'Có lỗi xảy ra khi kết nối server!', 'error');
                    });
            }
        });
    }
</script>