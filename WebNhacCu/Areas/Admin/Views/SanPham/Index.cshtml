@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<CoreDatabase.Models.SanPham>

@{
    ViewData["Title"] = "Quản lý Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml";
}

<!-- Nhúng thư viện SweetAlert2 để làm bảng popup xác nhận -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">DANH SÁCH SẢN PHẨM</h3>
        <a href="/Admin/SanPham/Create" class="btn btn-primary fw-bold">+ Thêm sản phẩm mới</a>
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Mã Loại</th>
                <th>Mã Thương hiệu</th>
                <th>Giá bán</th>
                <th>Số lượng tồn</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <!-- 1. Hình ảnh -->
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.HinhAnh))
                            {
                                <img src="~/images/sanpham/@item.HinhAnh" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
                            }
                            else
                            {
                                <span class="text-muted">Chưa có ảnh</span>
                            }
                        </td>

                        <!-- 2. Tên sản phẩm -->
                        <td class="fw-bold">@item.TenSP</td>

                        <!-- 3. Mã Loại -->
                        <td>
                            <span class="badge bg-secondary">@item.MaLoai</span>
                        </td>

                        <!-- 4. Mã Thương hiệu -->
                        <td>@item.MaTH</td>

                        <!-- 5. Giá bán -->
                        <td class="text-danger fw-bold">@string.Format("{0:N0} đ", item.DonGia)</td>

                        <!-- 6. Số lượng tồn -->
                        <td class="text-center">
                            <span class="badge bg-warning text-dark">@item.SoLuongTon</span>
                        </td>

                        <!-- 7. THAO TÁC: NÚT SỬA VÀ NÚT XÓA -->
                        <td class="text-center">
                            <!-- NÚT SỬA: Chuyển hướng sang trang Edit -->
                            <a href="/Admin/SanPham/Edit/@item.MaSP" class="btn btn-sm btn-outline-warning me-1" title="Sửa sản phẩm">
                                ✏️
                            </a>

                            <!-- NÚT XÓA: Gọi hàm Javascript bật Popup xác nhận -->
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete('@item.MaSP', '@item.TenSP')" title="Xóa sản phẩm">
                                🗑️
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- JAVASCRIPT XỬ LÝ POPUP XÁC NHẬN XÓA -->
<script>
    function confirmDelete(id, name) {
        Swal.fire({
            title: 'Xác nhận xóa?',
            text: `Bạn có chắc chắn muốn xóa sản phẩm "${name}" (Mã: ${id}) không?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Đồng ý xóa',
            cancelButtonText: 'Hủy bỏ'
        }).then((result) => {
            if (result.isConfirmed) {
                // Gửi request xóa đến Controller
                fetch(`/Admin/SanPham/Delete/${id}`, {
                    method: 'POST'
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                title: 'Đã xóa!',
                                text: 'Sản phẩm đã được xóa thành công khỏi CSDL.',
                                icon: 'success',
                                confirmButtonColor: '#198754'
                            }).then(() => {
                                location.reload(); // Load lại trang sau khi xóa
                            });
                        } else {
                            Swal.fire('Lỗi!', data.message || 'Không thể xóa sản phẩm này.', 'error');
                        }
                    })
                    .catch(error => {
                        Swal.fire('Lỗi!', 'Có lỗi xảy ra trong quá trình xóa.', 'error');
                    });
            }
        });
    }
</script>