<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nhạc Cụ Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="~/css/admin.css" rel="stylesheet" />

</head>
<body>

    <div class="d-flex" id="wrapper">
        <!-- SIDEBAR -->
        <div id="sidebar-wrapper">
            <a href="/Admin" class="sidebar-brand">
                <i class="fa-solid fa-guitar fs-4"></i>
                <span>NHẠC CỤ ADMIN</span>
            </a>

            <div class="sidebar-menu">
                <!-- Trang chủ -->
                <a href="/Admin" class="text-decoration-none text-white d-flex align-items-center gap-2 p-3 fw-bold">
                    <i class="fa-solid fa-house" style="color: #c5a059;"></i>
                    <span>Trang chủ</span>
                </a>

                <!-- 1. DANH MỤC -->
                <div class="menu-parent" onclick="toggleParent('menuDanhMuc', 'arrow1')">
                    <div class="d-flex align-items-center gap-2"><i class="fa-solid fa-list"></i><span>Danh mục</span></div>
                    <i class="fa-solid fa-chevron-down arrow-icon small" id="arrow1"></i>
                </div>
                <div class="submenu-container" id="menuDanhMuc">
                    <div class="sidebar-submenu">
                        <a href="/Admin/LoaiSanPham"><i class="fa-regular fa-circle"></i>Loại sản phẩm</a>
                        <a href="/Admin/SanPham"><i class="fa-regular fa-circle"></i>Sản phẩm</a>
                        <a href="/Admin/ThuongHieu"><i class="fa-regular fa-circle"></i>Thương hiệu</a>
                    </div>
                </div>

                <!-- 2. NGHIỆP VỤ -->
                <div class="menu-parent" onclick="toggleParent('menuNghiepVu', 'arrow2')">
                    <div class="d-flex align-items-center gap-2"><i class="fa-solid fa-briefcase"></i><span>Nghiệp vụ</span></div>
                    <i class="fa-solid fa-chevron-down arrow-icon small" id="arrow2"></i>
                </div>
                <div class="submenu-container" id="menuNghiepVu">
                    <!-- BÁN HÀNG -->
                    <div class="group-title">BÁN HÀNG</div>
                    <div class="sidebar-submenu">
                        <a href="/Admin/HoaDon/Index">Lập hóa đơn</a>
                        
                    </div>
                    <!-- KHO -->
                    <div class="group-title">KHO</div>
                    <div class="sidebar-submenu">
                        <a class="nav-link" href="/Admin/PhieuNhap"> <i class="fa-solid fa-boxes-packing"></i> Phiếu nhập </a>
                        
                        <a class="nav-link" href="/Admin/NhaCC"> <i class="fa-solid fa-truck-field"></i> Nhà cung cấp </a>
                    </div>
                    <!-- KHUYẾN MÃI -->
                    <div class="group-title">KHUYẾN MÃI</div>
                    <div class="sidebar-submenu">
                        <a href="/Admin/KhuyenMai"><i class="fa-solid fa-tag"></i>Danh sách khuyến mãi</a>
                        
                    </div>
                </div>

                <!-- 3. THỐNG KÊ -->
                <div class="menu-parent" onclick="toggleParent('menuThongKe', 'arrow3')">
                    <div class="d-flex align-items-center gap-2"><i class="fa-solid fa-chart-line"></i><span>Thống kê</span></div>
                    <i class="fa-solid fa-chevron-down arrow-icon small" id="arrow3"></i>
                </div>
                <div class="submenu-container" id="menuThongKe">
                    <div class="sidebar-submenu">
                        <a href="/Admin/ThongKeDoanhThu"><i class="fa-solid fa-coins"></i>Doanh thu</a>   
                        <a href="/Admin/SanPhamBanChay"><i class="fa-solid fa-fire"></i>Sản phẩm bán chạy</a>
                        <a href="/Admin/ThongKeNhapHang"><i class="fa-solid fa-truck-ramp-box"></i>Nhập hàng</a>
                    </div>
                </div>

                <!-- 4. HỆ THỐNG -->
                <div class="menu-parent" onclick="toggleParent('menuHeThong', 'arrow4')">
                    <div class="d-flex align-items-center gap-2"><i class="fa-solid fa-gear"></i><span>Hệ thống</span></div>
                    <i class="fa-solid fa-chevron-down arrow-icon small" id="arrow4"></i>
                </div>
                <div class="submenu-container" id="menuHeThong">
                    <div class="sidebar-submenu">
                        <a href="/Admin/KhachHang"><i class="fa-solid fa-users"></i>Khách hàng</a>
                        <a href="/Admin/NhanVien"><i class="fa-solid fa-user-tie"></i>Nhân viên</a>
                        <a href="/Admin/PhanQuyen"><i class="fa-solid fa-user-shield"></i>Phân quyền</a>
                        <a href="/Admin/DoiMatKhau"><i class="fa-solid fa-key"></i>Đổi mật khẩu</a>
                        <a href="/Account/Logout" class="text-danger"><i class="fa-solid fa-right-from-bracket"></i>Đăng xuất</a>
                    </div>
                </div>

            </div>
        </div>

        <!-- MAIN CONTENT -->
        <div id="page-content-wrapper" class="flex-grow-1">
            <div class="bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold">@ViewData["Title"]</h5>
                <span class="text-muted">Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")</span>
            </div>
            @RenderBody()
        </div>
    </div>

    <script>
            function toggleParent(menuId, arrowId) {
                var menu = document.getElementById(menuId);
                var arrow = document.getElementById(arrowId);
                if (menu.classList.contains('show')) {
                    menu.classList.remove('show');
                    arrow.classList.remove('rotate');
                } else {
                    menu.classList.add('show');
                    arrow.classList.add('rotate');
                }
            }
    </script>
</body>
</html>