<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Cửa Hàng Nhạc Cụ</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- FontAwesome Icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="admin-wrapper">
        <!-- ==================== SIDEBAR ==================== -->
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <h3><i class="fa-solid fa-guitar me-2"></i> Nhạc Cụ Admin</h3>
            </div>

            <ul class="sidebar-menu">
                <!-- 1. Trang chủ -->
                <li class="menu-item">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <span><i class="fa-solid fa-house menu-icon"></i> Trang chủ</span>
                    </a>
                </li>

                <!-- 2. Danh mục (Sổ xuống) -->
                <li class="menu-item">
                    <a href="javascript:void(0)" data-bs-toggle="collapse" data-bs-target="#menuDanhMuc" aria-expanded="false" class="d-flex align-items-center justify-content-between">
                        <span><i class="fa-solid fa-layer-group menu-icon"></i> Danh mục</span>
                        <i class="fa-solid fa-chevron-down fs-7"></i>
                    </a>
                    <div class="collapse" id="menuDanhMuc">
                        <ul class="submenu">
                            <li><a asp-area="Admin" asp-controller="LoaiSP" asp-action="Index"><i class="fa-regular fa-circle me-2"></i>Loại sản phẩm</a></li>
                            <li><a asp-area="Admin" asp-controller="SanPham" asp-action="Index"><i class="fa-regular fa-circle me-2"></i>Sản phẩm</a></li>
                            <li><a asp-area="Admin" asp-controller="ThuongHieu" asp-action="Index"><i class="fa-regular fa-circle me-2"></i>Thương hiệu</a></li>
                        </ul>
                    </div>
                </li>

                <!-- 3. Nghiệp vụ (Sổ xuống) -->
                <li class="menu-item">
                    <a href="javascript:void(0)" data-bs-toggle="collapse" data-bs-target="#menuNghiepVu" aria-expanded="false" class="d-flex align-items-center justify-content-between">
                        <span><i class="fa-solid fa-briefcase menu-icon"></i> Nghiệp vụ</span>
                        <i class="fa-solid fa-chevron-down fs-7"></i>
                    </a>
                    <div class="collapse" id="menuNghiepVu">
                        <ul class="submenu">
                            <!-- Bán hàng -->
                            <li class="px-3 pt-2 text-warning fw-bold fs-8"> BÁN HÀNG </li>
                            <li><a asp-area="Admin" asp-controller="BanHang" asp-action="LapHoaDon"><i class="fa-solid fa-cart-plus me-2"></i>Lập hóa đơn</a></li>
                            <li><a asp-area="Admin" asp-controller="BanHang" asp-action="DanhSachHoaDon"><i class="fa-solid fa-receipt me-2"></i>Danh sách hóa đơn</a></li>
                            <li><a asp-area="Admin" asp-controller="BanHang" asp-action="ChiTietHoaDon"><i class="fa-solid fa-file-invoice me-2"></i>Chi tiết hóa đơn</a></li>

                            <!-- Kho -->
                            <li class="px-3 pt-2 text-warning fw-bold fs-8"> KHO </li>
                            <li><a asp-area="Admin" asp-controller="Kho" asp-action="NhapHang"><i class="fa-solid fa-boxes-packing me-2"></i>Nhập hàng</a></li>
                            <li><a asp-area="Admin" asp-controller="Kho" asp-action="ChiTietNhapHang"><i class="fa-solid fa-box-open me-2"></i>Chi tiết nhập hàng</a></li>
                            <li><a asp-area="Admin" asp-controller="Kho" asp-action="NhaCungCap"><i class="fa-solid fa-truck-field me-2"></i>Nhà cung cấp</a></li>

                            <!-- Khuyến mãi -->
                            <li class="px-3 pt-2 text-warning fw-bold fs-8"> KHUYẾN MÃI </li>
                            <li><a asp-area="Admin" asp-controller="KhuyenMai" asp-action="Index"><i class="fa-solid fa-tags me-2"></i>Danh sách khuyến mãi</a></li>
                            <li><a asp-area="Admin" asp-controller="KhuyenMai" asp-action="ApDung"><i class="fa-solid fa-percent me-2"></i>Áp dụng SP khuyến mãi</a></li>
                        </ul>
                    </div>
                </li>

                <!-- 4. Thống kê (Sổ xuống) -->
                <li class="menu-item">
                    <a href="javascript:void(0)" data-bs-toggle="collapse" data-bs-target="#menuThongKe" aria-expanded="false" class="d-flex align-items-center justify-content-between">
                        <span><i class="fa-solid fa-chart-line menu-icon"></i> Thống kê</span>
                        <i class="fa-solid fa-chevron-down fs-7"></i>
                    </a>
                    <div class="collapse" id="menuThongKe">
                        <ul class="submenu">
                            <li><a asp-area="Admin" asp-controller="ThongKe" asp-action="DoanhThu"><i class="fa-solid fa-coins me-2"></i>Doanh thu</a></li>
                            <li><a asp-area="Admin" asp-controller="ThongKe" asp-action="HoaDon"><i class="fa-solid fa-file-lines me-2"></i>Hóa đơn</a></li>
                            <li><a asp-area="Admin" asp-controller="ThongKe" asp-action="SanPhamBanChay"><i class="fa-solid fa-fire me-2"></i>Sản phẩm bán chạy</a></li>
                            <li><a asp-area="Admin" asp-controller="ThongKe" asp-action="HangTonKho"><i class="fa-solid fa-warehouse me-2"></i>Hàng tồn kho</a></li>
                            <li><a asp-area="Admin" asp-controller="ThongKe" asp-action="NhapHang"><i class="fa-solid fa-truck-ramps me-2"></i>Nhập hàng</a></li>
                        </ul>
                    </div>
                </li>

                <!-- 5. Hệ thống (Sổ xuống) -->
                <li class="menu-item">
                    <a href="javascript:void(0)" data-bs-toggle="collapse" data-bs-target="#menuHeThong" aria-expanded="false" class="d-flex align-items-center justify-content-between">
                        <span><i class="fa-solid fa-gears menu-icon"></i> Hệ thống</span>
                        <i class="fa-solid fa-chevron-down fs-7"></i>
                    </a>
                    <div class="collapse" id="menuHeThong">
                        <ul class="submenu">
                            <li><a asp-area="Admin" asp-controller="KhachHang" asp-action="Index"><i class="fa-solid fa-users me-2"></i>Khách hàng</a></li>
                            <li><a asp-area="Admin" asp-controller="NhanVien" asp-action="Index"><i class="fa-solid fa-user-tie me-2"></i>Nhân viên</a></li>
                            <li><a asp-area="Admin" asp-controller="HeThong" asp-action="PhanQuyen"><i class="fa-solid fa-user-shield me-2"></i>Phân quyền</a></li>
                            <li><a asp-area="Admin" asp-controller="TaiKhoan" asp-action="DoiMatKhau"><i class="fa-solid fa-key me-2"></i>Đổi mật khẩu</a></li>
                            <li><a asp-area="Admin" asp-controller="TaiKhoan" asp-action="DangXuat" class="text-danger"><i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất</a></li>
                        </ul>
                    </div>
                </li>
            </ul>
        </aside>

        <!-- ==================== CONTENT AREA ==================== -->
        <div class="admin-content">
            <!-- Topbar Navigation -->
            <header class="admin-topbar">
                <!-- Thanh tìm kiếm -->
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" placeholder="Tìm kiếm sản phẩm, đơn hàng, khách hàng..." />
                </div>

                <!-- Thông tin Admin -->
                <div class="user-profile">
                    <div class="text-end me-2">
                        <div class="fw-bold" style="font-size: 0.9rem; color: #2c1d11;">Quản trị viên</div>
                        <small class="text-muted" style="font-size: 0.75rem;">admin@nhaccu.com</small>
                    </div>
                    <div class="user-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>
                </div>
            </header>

            <!-- Main Body Nội dung chính -->
            <main class="main-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- JS Scripts (Được đặt ở cuối trang để đảm bảo sự kiện click hoạt động) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>