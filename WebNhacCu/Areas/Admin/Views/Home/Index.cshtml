@model WebNhacCu.Areas.Admin.Models.DashboardViewModel

@{
    ViewData["Title"] = "Trang chủ Admin";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Tổng Quan Hệ Thống</h2>
        <span class="text-muted fw-semibold">Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")</span>
    </div>

    <!-- KHUNG 4 Ô THỐNG KÊ TỰ ĐỘNG -->
    <div class="row g-4">
        <!-- 1. Doanh thu tháng -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-3 bg-white">
                <div class="text-muted mb-1 fw-semibold">Doanh Thu Tháng</div>
                <h3 class="fw-bold text-dark mb-2">@string.Format("{0:N0} đ", Model.DoanhThuThang)</h3>
                <div class="fs-4 text-primary"><i class="bi bi-cash-stack"></i> 💰</div>
            </div>
        </div>

        <!-- 2. Hóa đơn mới -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-3 bg-white">
                <div class="text-muted mb-1 fw-semibold">Hóa Đơn Mới</div>
                <h3 class="fw-bold text-dark mb-2">@Model.HoaDonMoi</h3>
                <div class="fs-4 text-dark"><i class="bi bi-receipt"></i> 🧾</div>
            </div>
        </div>

        <!-- 3. Sản phẩm tồn kho -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-3 bg-white">
                <div class="text-muted mb-1 fw-semibold">Sản Phẩm Tồn Kho</div>
                <h3 class="fw-bold text-dark mb-2">@Model.SanPhamTonKho</h3>
                <div class="fs-4 text-dark"><i class="bi bi-music-note-beamed"></i> 🎸</div>
            </div>
        </div>

        <!-- 4. Khách hàng mới -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-3 bg-white">
                <div class="text-muted mb-1 fw-semibold">Khách Hàng Mới</div>
                <h3 class="fw-bold text-dark mb-2">@Model.KhachHangMoi</h3>
                <div class="fs-4 text-dark"><i class="bi bi-person-plus-fill"></i> 👤+</div>
            </div>
        </div>
    </div>
</div>

    