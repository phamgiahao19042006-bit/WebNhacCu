@model WebNhacCu.Areas.Admin.Models.DashboardViewModel

@{
    ViewData["Title"] = "Trang chủ Admin";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml";
}

<div class="container-fluid p-0">
    <!-- Tiêu đề trang -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h3 class="fw-bold" style="color: #2c1d11;">Tổng Quan Hệ Thống</h3>
        <span class="text-muted">Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")</span>
    </div>

    <!-- 4 Thẻ Thống kê Nhanh (Stat Cards) -->
