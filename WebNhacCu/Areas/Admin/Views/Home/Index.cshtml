        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div>
                    <div class="stat-title">Doanh Thu Tháng</div>
                    <div class="stat-value">128,500,000 ₫</div>
                </div>
                <div class="stat-icon">
                    <i class="fa-solid fa-sack-dollar"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div>
                    <div class="stat-title">Hóa Đơn Mới</div>
                    <div class="stat-value">45</div>
                </div>
                <div class="stat-icon">
                    <i class="fa-solid fa-receipt"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div>
                    <div class="stat-title">Sản Phẩm Tồn Kho</div>
                    <div class="stat-value">312</div>
                </div>
                <div class="stat-icon">
                    <i class="fa-solid fa-guitar"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div>
                    <div class="stat-title">Khách Hàng Mới</div>
                    <div class="stat-value">18</div>
                </div>
                <div class="stat-icon">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
            </div>
        </div>
    </div>

