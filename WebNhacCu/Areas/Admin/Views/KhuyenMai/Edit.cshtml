@model CoreDatabase.Models.KhuyenMai
@{
    ViewData["Title"] = "Cập Nhật Khuyến Mãi";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container-fluid p-4 bg-light" style="min-height: 100vh;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-pen-to-square fs-3 text-warning"></i>
            <h3 class="fw-bold m-0 text-primary text-uppercase">CẬP NHẬT KHUYẾN MÃI: @Model?.MaKM</h3>
        </div>
        <a href="/Admin/KhuyenMai/Index" class="btn btn-outline-secondary btn-sm fw-semibold">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm p-4">
        <form action="/Admin/KhuyenMai/Edit/@Model?.MaKM" method="post">
            @Html.AntiForgeryToken()
            <!-- Khóa chính Mã KM (chỉ đọc) -->
            <input type="hidden" name="MaKM" value="@Model?.MaKM" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Mã Khuyến Mãi</label>
                    <input type="text" class="form-control bg-light" value="@Model?.MaKM" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Tên Chương Trình Khuyến Mãi <span class="text-danger">*</span></label>
                    <input type="text" name="TenKhuyenMai" value="@Model?.TenKhuyenMai" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Loại Giảm</label>
                    <select name="LoaiGiam" class="form-select">
                        <option value="Giảm theo %" selected="@(Model?.LoaiGiam == "Giảm theo %")">Giảm theo %</option>
                        <option value="Giảm theo tiền" selected="@(Model?.LoaiGiam == "Giảm theo tiền")">Giảm theo tiền</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Giá Trị Giảm <span class="text-danger">*</span></label>
                    <input type="number" step="any" name="GiaTriGiam" value="@Model?.GiaTriGiam" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Ngày Bắt Đầu <span class="text-danger">*</span></label>
                    <input type="date" name="NgayBatDau" value="@Model?.NgayBatDau.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Ngày Kết Thúc <span class="text-danger">*</span></label>
                    <input type="date" name="NgayKetThuc" value="@Model?.NgayKetThuc.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-bold text-dark">Điều Kiện Áp Dụng</label>
                    <input type="text" name="DieuKienApDung" value="@Model?.DieuKienApDung" class="form-control" />
                </div>

                <div class="col-md-12">
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" asp-for="TT" checked />
                        <label class="form-check-label fw-bold text-dark" asp-for="TT">Kích hoạt ngay (Trạng thái)</label>
                    </div>
                </div>
            </div>

            <div class="mt-4 border-top pt-3 text-end">
                <a href="/Admin/KhuyenMai/Index" class="btn btn-light border me-2">Hủy</a>
                <button type="submit" class="btn btn-warning px-4 fw-semibold text-white">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Cập Nhật Khuyến Mãi
                </button>
            </div>
        </form>
    </div>
</div>