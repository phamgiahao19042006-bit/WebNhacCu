@model CoreDatabase.Models.KhuyenMai
@{
    ViewData["Title"] = "Chi Tiết Khuyến Mãi";
    Layout = "~/Areas/Admin/Views/Shared/_admin.cshtml";
    var listCT = ViewBag.ChiTietList as List<CoreDatabase.Models.CTKhuyenMai>;
    DateTime now = DateTime.Now;
    bool isDangDienRa = Model != null && Model.TT && Model.NgayBatDau <= now && Model.NgayKetThuc >= now;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container-fluid p-4 bg-light" style="min-height: 100vh;">
    <!-- Header (Đã bỏ Breadcrumb bên phải) -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-tag fs-3 text-primary"></i>
            <h3 class="fw-bold m-0 text-primary text-uppercase">CHI TIẾT KHUYẾN MÃI</h3>
        </div>
    </div>

    <!-- Thanh Thao Tác (Đã bỏ nút Excel) -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="/Admin/KhuyenMai/Index" class="btn btn-outline-secondary btn-sm fw-semibold">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
        <h5 class="fw-bold text-primary m-0">KHUYẾN MÃI: @Model?.MaKM - @Model?.TenKhuyenMai?.ToUpper()</h5>
        <button onclick="window.print()" class="btn btn-outline-dark btn-sm">
            <i class="fa-solid fa-print me-1"></i> In
        </button>
    </div>

    <div class="row g-3">
        <!-- Khối Thông Tin Khuyến Mãi -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3">
                <h6 class="fw-bold text-primary text-uppercase mb-3 border-bottom pb-2">THÔNG TIN KHUYẾN MÃI</h6>
                <table class="table table-borderless table-sm fs-6 mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted" style="width: 120px;">Mã khuyến mãi</td>
                            <td>: <strong class="text-dark">@Model?.MaKM</strong></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Tên khuyến mãi</td>
                            <td>: <strong class="text-dark">@Model?.TenKhuyenMai</strong></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Loại giảm</td>
                            <td>: @Model?.LoaiGiam</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Giá trị giảm</td>
                            <td>: <strong class="text-danger">@(Model?.LoaiGiam != null && Model.LoaiGiam.Contains("%") ? $"{Model.GiaTriGiam:N0}%" : $"{Model.GiaTriGiam:N0}đ")</strong></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Ngày bắt đầu</td>
                            <td>: @Model?.NgayBatDau.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Ngày kết thúc</td>
                            <td>: @Model?.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Điều kiện áp dụng</td>
                            <td>: @(string.IsNullOrEmpty(Model?.DieuKienApDung) ? "Không có" : Model.DieuKienApDung)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Trạng thái</td>
                            <td>
                                :
                                @if (isDangDienRa)
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">Đang diễn ra</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill">Chưa/Đã kết thúc</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Khối Danh Sách Sản Phẩm Áp Dụng -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100 p-3">
                <h6 class="fw-bold text-primary text-uppercase mb-3 border-bottom pb-2">DANH SÁCH SẢN PHẨM ÁP DỤNG</h6>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-3 text-center" style="font-size: 13px;">
                        <thead class="bg-light border-bottom fw-bold text-dark">
                            <tr>
                                <th class="py-2">STT</th>
                                <th class="py-2">Mã sản phẩm</th>
                                <th class="py-2 text-start">Tên sản phẩm</th>
                                <th class="py-2">Hệ số</th>
                                <th class="py-2">Số lượng tối thiểu</th>
                                <th class="py-2">Số lượng tối đa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listCT != null && listCT.Any())
                            {
                                int stt = 1;
                                foreach (var ct in listCT)
                                {
                                    <tr>
                                        <td>@(stt++)</td>
                                        <td class="fw-bold text-primary">@ct.MaSP</td>
                                        <td class="text-start">@(ct.SanPham?.TenSP ?? ct.MaSP)</td>
                                        <td>@(ct.HeSo ?? 1)</td>
                                        <td>@(ct.SoLuong.HasValue ? ct.SoLuong.Value.ToString() : "-")</td>
                                        <td>-</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">Khuyến mãi này áp dụng cho toàn bộ cửa hàng hoặc chưa gán sản phẩm cụ thể.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="fw-bold text-muted small">
                    Tổng số sản phẩm: <span class="text-primary">@(listCT?.Count ?? 0)</span>
                </div>
            </div>
        </div>
    </div>
</div>