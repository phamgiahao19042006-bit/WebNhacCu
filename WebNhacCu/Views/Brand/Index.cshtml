@using CoreDatabase.Models
@model List<ThuongHieu>

@{
    ViewData["Title"] = "Thương hiệu";
}

<h2>Thương hiệu</h2>

@if (!Model.Any())
{
    <p>Chưa có thương hiệu nào.</p>
}
else
{
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@item.TenTH</h5>

                        @if (!string.IsNullOrEmpty(item.QuocGia))
                        {
                            <p class="card-text">Xuất xứ: @item.QuocGia</p>
                        }

                        <a asp-controller="Product"
                           asp-action="Index"
                           asp-route-brandId="@item.MaTH"
                           class="btn btn-primary btn-sm">
                            Xem sản phẩm
                        </a>
                    </div>
                </div>
            </div>
        }

    </div>
}
